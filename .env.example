# --- Edge ---
# Host port published by the Caddy edge proxy.
EDGE_PORT=8080

# The origin browsers use. Set to http://<host-ip>:8080 to log in from other
# LAN machines (feeds Keycloak's hostname, the realm redirect URIs, and the
# issuer the backend asserts). With the default, everything works from the
# compose host untouched. Changing it requires recreating keycloak:
#   docker compose up --force-recreate keycloak
PUBLIC_ORIGIN=http://localhost:8080

# --- PowerDNS ---
# PowerDNS API endpoint the backend talks to.
# The default targets the demo PowerDNS container of this compose stack.
# To manage a real PowerDNS instead, point it at its API and use the real key:
#   PDNS_API_URL=http://10.0.0.12:8081/api/v1
PDNS_API_URL=http://pdns:8081/api/v1
PDNS_API_KEY=changeme-dev-key

# --- Zone policy ---
# Comma-separated; never deletable/zone-modifiable regardless of who is
# authenticated. Set this to the zone(s) your homelab actually resolves
# against before trusting this tool with it.
PROTECTED_ZONES=example.test.
# NS content for zones created through the UI.
DEFAULT_NS=ns1.example.test.

# --- Keycloak (dev-mode; read "Before trusting this on your LAN" in README) ---
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=changeme-dev-admin # admin console is NOT routed through the edge
PDNS_ADMIN_LITE_USER=demo            # the login any LAN user can use until you change it
PDNS_ADMIN_LITE_PASSWORD=demo
OIDC_ISSUER=${PUBLIC_ORIGIN}/auth/realms/pdns-admin-lite
OIDC_JWKS_URL=http://keycloak:8080/auth/realms/pdns-admin-lite/protocol/openid-connect/certs
OIDC_AUDIENCE=pdns-admin-lite-api
